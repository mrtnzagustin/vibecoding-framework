{
  "name": "vibecoding-framework",
  "version": "1.0.0",
  "description": "A specification-driven development framework combining GitHub Spec-Kit with VibeCoding workflows",
  "scripts": {
    "prepare": "husky install",
    "init-project": "bash .specify/scripts/bash/init-project.sh",
    "create-feature": "bash .specify/scripts/bash/create-feature.sh",
    "validate-spec": "bash .specify/scripts/bash/validate-spec.sh",
    "lint": "echo '(configure your linter here)' && exit 0",
    "test": "echo '(configure your test command here)' && exit 0",
    "format": "echo '(configure your formatter here)' && exit 0",
    "typecheck": "echo '(configure your typecheck command here)' && exit 0"
  },
  "keywords": [
    "vibecoding",
    "spec-kit",
    "specification-driven",
    "development",
    "ai",
    "claude",
    "github-copilot",
    "cursor",
    "template"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
